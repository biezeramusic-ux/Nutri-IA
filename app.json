{
  "expo": {
    "name": "Nutrifitness AI",
    "slug": "nutri-ai",
    "scheme": "nutrifitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.nutrifitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Nutrifitness AI usa a câmera para analisar as suas refeições.",
        "NSLocationWhenInUseUsageDescription": "O Nutrifitness AI usa a sua localização para desenhar a rota e contar os km das suas caminhadas."
      }
    },
    "android": {
      "package": "mz.nutrifitness.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Nutrifitness AI usa a câmera para analisar as suas refeições."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4CAF50"
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Nutrifitness AI lê os seus passos e distância do Apple Saúde para mostrar a sua atividade.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "O Nutrifitness AI usa o sensor de movimento para contar os seus passos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Nutrifitness AI usa a sua localização para desenhar a rota e contar os km das suas caminhadas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Nutrifitness AI acede às suas fotos para analisar refeições."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NutritionWidget",
              "label": "Nutrifitness AI",
              "description": "Calorias e macros do dia, e atalho para adicionar um alimento.",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CaloriesWidget",
              "label": "Nutrifitness AI · Calorias",
              "description": "Anel com as calorias que faltam hoje.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WaterWidget",
              "label": "Nutrifitness AI · Água",
              "description": "Água de hoje e atalho para registar.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}

{
  "expo": {
    "name": "Nutri IA",
    "slug": "nutri-ai",
    "scheme": "nutriai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.nutriai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Nutri IA usa a câmera para analisar as suas refeições."
      }
    },
    "android": {
      "package": "mz.nutriai.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Nutri IA usa a câmera para analisar as suas refeições."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4CAF50"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Nutri IA acede às suas fotos para analisar refeições."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NutritionWidget",
              "label": "Nutri IA",
              "description": "Calorias e macros do dia, e atalho para adicionar um alimento.",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CaloriesWidget",
              "label": "Nutri IA · Calorias",
              "description": "Anel com as calorias que faltam hoje.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WaterWidget",
              "label": "Nutri IA · Água",
              "description": "Água de hoje e atalho para registar.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
